# Postgres connection string.
# Local development: `npm run db:dev` starts Prisma's local Postgres at this address. It is an
# embedded database with one shared session, hence pgbouncer=true (no named prepared statements)
# and a single connection. Render: render.yaml fills this in from the database it creates.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"

# Long random string used to sign session cookies. Production refuses to start without one of at
# least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# The site's public address, used in emails and for Stripe's success and cancel redirects
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# stripe: real Stripe Checkout (test or live keys)
# mock: "Activate" buttons that list a contractor without charging. Development only: production
#       ignores it unless ALLOW_MOCK_BILLING="true" (for a private staging site).
BILLING_MODE="mock"

# Stripe keys. Leave blank while BILLING_MODE=mock.
# Create two recurring monthly Prices (Basic and Featured) and paste their price_... ids.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_FEATURED=""

# Email for password resets and new-message notifications, sent through Resend (resend.com).
# Leave RESEND_API_KEY blank in development: emails are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="TaylorWorks <hello@example.com>"

# Optional: a webhook URL (Slack or Discord incoming webhook) that gets a short alert when the
# server hits an error. Errors are always written to the server log either way.
ERROR_ALERT_WEBHOOK_URL=""
