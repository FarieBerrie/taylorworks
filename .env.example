# SQLite file, resolved relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL Stripe uses for success and cancel redirects
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# mock: local "activate listing" buttons, no card charge (default when Stripe keys are empty)
# stripe: real Stripe Checkout in test mode
BILLING_MODE="mock"

# Stripe test-mode keys. Leave blank while BILLING_MODE=mock.
# Create two recurring monthly Prices and paste their price_... ids.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_FEATURED=""
